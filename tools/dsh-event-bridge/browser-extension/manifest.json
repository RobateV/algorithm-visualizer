{
  "manifest_version": 3,
  "name": "Local DSH Review Relay (Experimental)",
  "version": "0.1.0",
  "description": "仅将本机 DSH 的 GitHub 结果位置送往指定 ChatGPT 聊天。默认关闭。",
  "permissions": ["storage", "alarms"],
  "host_permissions": ["http://127.0.0.1:17321/*", "https://chatgpt.com/*"],
  "background": {"service_worker": "background.js"},
  "action": {"default_popup": "popup.html"},
  "content_scripts": [{"matches": ["https://chatgpt.com/c/*"], "js": ["content.js"]}]
}
